{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/fb", "destination": "/?utm_source=facebook&utm_medium=nhom&utm_campaign=oc2&utm_content=tin-a", "permanent": false },
    { "source": "/zalo", "destination": "/?utm_source=zalo&utm_medium=chat&utm_campaign=oc2&utm_content=tin-a", "permanent": false },
    { "source": "/qr", "destination": "/?utm_source=truc-tiep&utm_medium=qr&utm_campaign=oc2&utm_content=tin-b", "permanent": false },
    { "source": "/goi", "destination": "/?utm_source=goi-dien&utm_medium=zalo&utm_campaign=oc2&utm_content=tin-b", "permanent": false },
    { "source": "/gioithieu", "destination": "/?utm_source=gioi-thieu&utm_medium=nguoi-dung&utm_campaign=oc2&utm_content=tin-c", "permanent": false },
    { "source": "/doitac", "destination": "/?utm_source=gioi-thieu&utm_medium=doi-tac&utm_campaign=oc2&utm_content=tin-c", "permanent": false }
  ],
  "rewrites": [
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://img.vietqr.io https://*.supabase.co https://tile.openstreetmap.org data: blob:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://thumua365-api-staging.onrender.com; font-src 'self'; frame-ancestors 'none'" }
      ]
    }
  ]
}
