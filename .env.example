# Sao chép thành .env.local rồi điền. KHÔNG commit file đã điền.
#
# Chỉ anon key được đưa vào frontend — nó chịu RLS, lộ ra cũng không đọc được
# dữ liệu của người khác. service_role bỏ qua RLS, chỉ dùng trong script quản
# trị chạy trên máy và trong Edge Function; không bao giờ đặt vào biến VITE_*.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Nest API. Dev mặc định /api/v1 (Vite proxy → http://127.0.0.1:3000).
# Production/Android: URL tuyệt đối, ví dụ https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Chỉ dùng cho scripts/admin-reset-password.ts — truyền lúc chạy, đừng lưu file.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
