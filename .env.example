# Sao chép thành .env.local rồi điền. KHÔNG commit file đã điền.
#
# Chỉ anon key được đưa vào frontend — nó chịu RLS, lộ ra cũng không đọc được
# dữ liệu của người khác. service_role bỏ qua RLS, chỉ dùng trong script quản
# trị chạy trên máy và trong Edge Function; không bao giờ đặt vào biến VITE_*.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Khoá sb_publishable_… (Supabase → Settings → API Keys). Tên cũ VITE_SUPABASE_ANON_KEY vẫn đọc được.
VITE_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_…>

# Chỉ dùng cho scripts/admin-reset-password.ts — truyền lúc chạy, đừng lưu file.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# URL của Thumua365_BE — thiếu thì app chạy chế độ offline (sổ của máy này, không có đăng nhập).
# Máy dev: http://localhost:3000. Vercel production: https://thumua365-api-staging.onrender.com
# (bắt buộc https://; thiếu hoặc http thì build production báo lỗi — xem vite.config.ts).
VITE_API_URL=http://localhost:3000

# Mở app là gọi /v1/health để đánh thức API (Render free ngủ sau 15 phút, dậy mất ~20 giây).
# Đặt off khi API đã lên gói không ngủ — xem Thumua365_BE/ops/README.md "Gói free ↔ gói trả phí".
# VITE_API_WARMUP=off

# Nền bản đồ (màn Bản đồ). Bỏ trống = tile miễn phí của OpenStreetMap — chỉ hợp lưu lượng nhỏ
# (https://operations.osmfoundation.org/policies/tiles/). Lên lưu lượng thật thì đổi sang nhà cung
# cấp trả phí và ghi đúng nguồn của họ.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
