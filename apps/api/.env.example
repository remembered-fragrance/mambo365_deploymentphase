NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
PERSISTENCE=postgres
# Provision these two restricted logins after migration. Never use postgres/service_role for runtime.
DATABASE_URL=postgresql://mambo_app:CHANGE_ME@127.0.0.1:54322/postgres
WORKER_DATABASE_URL=postgresql://mambo_worker:CHANGE_ME@127.0.0.1:54322/postgres
DB_POOL_SIZE=10
# Production requires require (verified TLS); local only: disable.
DB_SSL=disable
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Optional legacy HS256 verification; server only.
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Storage server key: secret manager only; never a VITE_ variable or mobile bundle.
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_BUCKET=trade-private
