{
  "name": "thumua365",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "rules": "node scripts/check-rules.mjs",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/data/database.types.ts",
    "verify": "npm run lint && npm run typecheck && npm run rules && npm run boundaries && npm run test"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@supabase/supabase-js": "^2.112.2",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.3",
    "jspdf": "^4.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dependency-cruiser": "^17.0.1",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.11",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true
  }
}
